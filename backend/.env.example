# ==========================================================
# TASKFLOW BACKEND - Variables de entorno
# Copia este archivo como .env y ajusta los valores
# ==========================================================

# --- Servidor Express ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- MongoDB ---
# Local (desarrollo):      mongodb://localhost:27017/taskflow
# Docker Compose (red interna): mongodb://mongoserver:27017/taskflow
MONGO_URI=mongodb://localhost:27017/taskflow

# --- Redis (caché + cola FIFO) ---
# Local (desarrollo):      localhost / 6379
# Docker Compose:          redisserver / 6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# Tiempo máximo de espera al conectar con Redis (ms). Si expira, el
# backend arranca en modo degradado (sin caché ni cola).
REDIS_CONNECT_TIMEOUT_MS=4000

# --- Cola y canal de eventos hacia el Worker ---
COLA_SOLICITUDES=taskflow:solicitudes:cola
CANAL_EVENTOS=taskflow:eventos

# --- Caché ---
CACHE_PREFIX=taskflow
CACHE_TTL_SOLICITUDES=60
CACHE_TTL_INDICADORES=30
CACHE_TTL_MONITOR=5
CACHE_TTL_CATEGORIAS=300
HEARTBEAT_WORKER_TTL=30

# --- CORS (URL del frontend Vue) ---
CORS_ORIGIN=http://localhost:5173,http://localhost

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_MAX_ESCRITURA=60

# --- Logs ---
LOG_LEVEL=debug
