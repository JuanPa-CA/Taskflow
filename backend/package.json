{
  "name": "taskflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST + Socket.IO de TASKFLOW: recibe, valida, persiste en MongoDB y encola en Redis las solicitudes (sin procesarlas).",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js"
  },
  "keywords": [
    "taskflow",
    "express",
    "mongodb",
    "redis",
    "socket.io",
    "helpdesk"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}

