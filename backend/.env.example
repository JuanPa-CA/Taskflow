# ──────────────────────────────────────────────────────────────
# TASKFLOW · Backend — plantilla de variables de entorno
# Copiar como .env (NO subir .env real al repo) y ajustar si hace falta.
# En Docker Compose, los hosts son los NOMBRES DE SERVICIO, nunca localhost.
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# --- MongoDB ---
# mongoserver = nombre del servicio Mongo en docker-compose.yml
MONGO_URI=mongodb://mongoserver:27017/taskflow

# --- Redis (cache-aside + cola de solicitudes) ---
# redisserver = nombre del servicio Redis en docker-compose.yml
REDIS_HOST=redisserver
REDIS_PORT=6379
REDIS_PASSWORD=

# Key de la lista usada como cola de solicitudes pendientes (Worker hace BRPOP sobre esta key)
REDIS_QUEUE_KEY=taskflow:queue:solicitudes

# Canal de Redis Pub/Sub por el que el Worker avisa cambios de estado
# (el Worker no tiene Socket.IO; publica aquí y el backend retransmite)
REDIS_EVENTS_CHANNEL=taskflow:eventos

# TTL (segundos) del caché de estadísticas / listado
CACHE_TTL_SECONDS=60

# --- CORS ---
# URL donde corre el frontend Vue (dev server)
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
